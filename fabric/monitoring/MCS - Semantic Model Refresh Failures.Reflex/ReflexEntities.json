  {
    "uniqueIdentifier": "dba7a88e-457c-4f71-b4e1-3dcb1539020c",
    "payload": {
      "name": "Monitoring KQL database event",
      "runSettings": {
        "isStopped": false,
        "executionIntervalInSeconds": 3600
      },
      "query": {
        "queryString": "let lookback = 1h;\nlet refreshes =\n    SemanticModelLogs\n    | where Timestamp > ago(lookback)\n    | where OperationName == \"CommandEnd\"\n    | where EventText has \"refresh\"\n    | where isnotempty(ExecutingUser)\n    | where ItemName contains \"mcs_monitored\"\n    | project OperationId, EndTime = Timestamp, WorkspaceId, WorkspaceName,\n              ItemId, ItemName, ExecutingUser, DurationMs, CpuTimeMs,\n              CmdStatusCode = StatusCode, CmdLevel = Level;\nlet errs =\n    SemanticModelLogs\n    | where Timestamp > ago(lookback)\n    | where OperationName == \"Error\" or Level =~ \"Error\"\n    | summarize ErrEvents = count(),\n                ErrObjects = make_set(XmlaObjectPath, 10),\n                ErrMessages = make_set(EventText, 5)\n      by OperationId;\nlet metrics =\n    SemanticModelLogs\n    | where Timestamp > ago(lookback)\n    | where OperationName == \"ExecutionMetrics\"\n    | extend m = parse_json(EventText)\n    | project OperationId,\n              ErrorCount = toint(m.errorCount),\n              IntendedUsage = toint(m.intendedUsage),\n              PeakMemKB = tolong(m.approximatePeakMemConsumptionKB),\n              ThrottlingMs = toint(m.capacityThrottlingMs);\nrefreshes\n| join kind=leftouter errs on OperationId\n| join kind=leftouter metrics on OperationId\n| where CmdStatusCode != 0 or ErrEvents > 0 or ErrorCount > 0\n| extend RefreshTrigger = case(IntendedUsage == 1, \"Scheduled/API\",\n                               IntendedUsage == 2, \"OnDemand\",\n                               \"Other\")\n| project EndTime, WorkspaceName, ItemName, RefreshTrigger, ExecutingUser,\n          DurationMin = round(DurationMs / 60000.0, 2),\n          CmdStatusCode, ErrorCount, ThrottlingMs,\n          FailedObjects = ErrObjects, ErrorMessages = ErrMessages,\n          OperationId, ItemId, WorkspaceId\n| order by EndTime desc"
      },
      "eventhouseItem": {
        "itemId": "a8e1e028-d6c8-444b-ac69-d975d2302813",
        "workspaceId": "ff6a810c-a472-4e49-9583-835e0c5cb4fd",
        "itemType": "KustoDatabase"
      },
      "queryParameters": [],
      "metadata": {
        "workspaceId": "ff6a810c-a472-4e49-9583-835e0c5cb4fd",
        "querySetId": "6a0c21f2-2fc1-489f-9c59-8bdabe2862de",
        "queryId": "10809415-b5f6-4e1a-a5d5-817ad08f5686"
      },
      "parentContainer": {
        "targetUniqueIdentifier": "1eb7d30a-7567-45e6-a494-21d0c800f432"
      }
    },
    "type": "kqlSource-v1"
  },
