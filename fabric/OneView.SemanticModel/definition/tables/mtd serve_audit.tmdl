table 'mtd serve_audit'
	lineageTag: 34b441e6-f782-4b57-bede-70391c20696b

	measure ServeRows =
			
			SUM('mtd serve_audit'[rows_read]) + SUM('mtd serve_audit'[rows_written])
		formatString: 0
		lineageTag: 5765a49f-18df-4ca8-be26-886311553f73

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalAddition"
				}

		changedProperty = FormatString

	measure ServeFailure =
			
			DIVIDE(
			    COUNTROWS(FILTER('mtd serve_audit', 'mtd serve_audit'[status] = "Failure")),
			    COUNTROWS('mtd serve_audit'),
			    0
			)
		formatString: 0%;-0%;0%
		lineageTag: 50f32d0b-0708-402e-a4e8-afe66656e379

	measure Servesucess =
			
			DIVIDE(
			    COUNTROWS(FILTER('mtd serve_audit', 'mtd serve_audit'[status] = "Success")),
			    COUNTROWS('mtd serve_audit'),
			    0
			)
		lineageTag: 20cfcd42-75f7-4a11-8e26-9e3e8646ba41

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ServeFailureDisplay = IF ( ISBLANK ( 'mtd serve_audit'[ServeFailure] ), "0%", 'mtd serve_audit'[ServeFailure] )
		lineageTag: 3251ffda-7427-49af-a96e-47a52940b37c

