            "sqlReaderQuery": "SELECT \n    ec.*,\n    tc.transformation_id,\n    tc.process_stage,\n    tc.transformation_rule,\n    tc.transformation_type,\n    tc.transformation_rule_criteria,\n    tc.enable_flag AS transformation_enable_flag,\n    GETDATE() AS currentdatetime,\n    YEAR(GETDATE()) AS currentyear,\n    MONTH(GETDATE()) AS currentmonth,\n    DAY(GETDATE()) AS currentday\nFROM mtd.serve_control AS ec\nINNER JOIN mtd.transformation_config AS tc\n    ON ec.control_id = tc.control_id\nWHERE \n    ec.enable_flag = 1\n    AND tc.process_stage = 'serve'\n    AND tc.transformation_rule NOT LIKE 'pii%'\nORDER BY ec.control_id ASC;\n",
